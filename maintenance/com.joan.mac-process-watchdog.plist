<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.joan.mac-process-watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/mac-process-watchdog</string>
  </array>
  <key>StartInterval</key><integer>300</integer>
  <key>StartOnMount</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>Nice</key><integer>10</integer>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/mac-process-watchdog.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/mac-process-watchdog.log</string>
</dict>
</plist>
