# ── Homebrew (Apple Silicon, Intel or Linux) ─────────────────────────
for _brew in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
  if [[ -x $_brew ]]; then eval "$($_brew shellenv)"; break; fi
done
unset _brew

# Auto-start tmux on terminal open (before p10k to avoid instant-prompt conflicts).
# Guarded so a fresh machine without tmux doesn't exec into nothing and close the terminal.
# Not `exec`: if tmux fails to start (bad terminfo, broken config) you keep a plain shell and see
# the error instead of the tab closing instantly. A clean tmux exit still closes the tab.
if [[ -z "$TMUX" && "$TERM_PROGRAM" != "vscode" && -o interactive ]] && (( $+commands[tmux] )); then
  if [[ -n "$SSH_CONNECTION" ]]; then
    tmux new-session -A -s ssh && exit
  else
    tmux new-session && exit
  fi
fi

# Enable Powerlevel10k instant prompt — must stay near the top.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# ── PATH ─────────────────────────────────────────────────────────────
typeset -U path  # auto-deduplicate
path=($HOME/.local/bin $HOME/.cargo/bin $path)
export PATH

# ── Prompt ───────────────────────────────────────────────────────────
[[ -r $HOMEBREW_PREFIX/share/powerlevel10k/powerlevel10k.zsh-theme ]] && \
  source $HOMEBREW_PREFIX/share/powerlevel10k/powerlevel10k.zsh-theme
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# ── Completions (cached — only regenerate if dump is >24h old) ───────
autoload -Uz compinit
fpath=($HOME/.docker/completions $fpath)
_zcompdump=( ${ZDOTDIR:-$HOME}/.zcompdump(N.mh-24) )
if (( $#_zcompdump )); then
  compinit -C
else
  compinit
fi
unset _zcompdump

# ── Node (fnm) ───────────────────────────────────────────────────────
(( $+commands[fnm] )) && eval "$(fnm env --use-on-cd --shell zsh)"

# ── Aliases ──────────────────────────────────────────────────────────
alias vim="nvim"
# Claude Code in its own tmux window named after the project: ct [dir] [claude args]
alias ct="claude-tmux new"
# Pick a project → its own tmux session with claude + nvim windows (prefix f inside tmux)
alias tp="claude-tmux project"

# ── Tools ────────────────────────────────────────────────────────────
(( $+commands[fzf] )) && source <(fzf --zsh)
(( $+commands[zoxide] )) && eval "$(zoxide init zsh)"

# ── Google Cloud SDK (brew cask or manual install in ~) ──────────────
for _gcloud in "$HOMEBREW_PREFIX/share/google-cloud-sdk" "$HOME/google-cloud-sdk"; do
  if [[ -f "$_gcloud/path.zsh.inc" ]]; then
    source "$_gcloud/path.zsh.inc"
    [[ -f "$_gcloud/completion.zsh.inc" ]] && source "$_gcloud/completion.zsh.inc"
    break
  fi
done
unset _gcloud

# ── Machine-specific / private config (not tracked) ──────────────────
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

# ── Plugins (syntax-highlighting must be last) ────────────────────────
ZSH_AUTOSUGGEST_USE_ASYNC=true
[[ -r $HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]] && \
  source $HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh
[[ -r $HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] && \
  source $HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
