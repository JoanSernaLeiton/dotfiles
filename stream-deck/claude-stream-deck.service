[Unit]
Description=Claude Stream Deck coordinator
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=joanserna
WorkingDirectory=/home/joanserna/claude-stream-deck
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/joanserna/claude-stream-deck/claude_stream_deck_server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
