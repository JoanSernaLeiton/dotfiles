#!/usr/bin/env python3
import json
import os
import re
import signal
import socket
import subprocess
import sys
import threading
import time
import traceback
import urllib.error
import urllib.request
from pathlib import Path

CONFIGURATION_PATH = Path.home() / ".config" / "claude-stream-deck" / "config.json"
CACHE_DIRECTORY = Path.home() / ".cache" / "claude-stream-deck"
SESSION_TITLE_CACHE_DIRECTORY = CACHE_DIRECTORY / "session-titles"
ERROR_LOG_PATH = CACHE_DIRECTORY / "errors.log"
MAXIMUM_ERROR_LOG_BYTES = 256 * 1024
INTERACTIVE_ENTRYPOINT = "cli"
DECK_ENABLED_ENVIRONMENT_VARIABLE = "CLAUDE_STREAM_DECK"
DECK_ENABLING_VALUES = frozenset({"1", "true", "on", "yes", "si", "sí"})
QUESTION_TOOL_NAME = "AskUserQuestion"
TERMINAL_ONLY_PERMISSION_TOOL_NAMES = frozenset({"ExitPlanMode"})
SHORT_REQUEST_TIMEOUT_SECONDS = 3
LONG_POLL_SECONDS = 10
LONG_POLL_HTTP_TIMEOUT_SECONDS = LONG_POLL_SECONDS + 5
MAXIMUM_CONSECUTIVE_POLL_FAILURES = 3
POLL_FAILURE_PAUSE_SECONDS = 2
OVERALL_WAIT_LIMIT_SECONDS = 1780
SHORT_SESSION_ID_LENGTH = 6
TMUX_QUERY_TIMEOUT_SECONDS = 1
PROCESS_QUERY_TIMEOUT_SECONDS = 1
MAXIMUM_ANCESTOR_PROCESS_LEVELS = 5
AGENT_NAME_ARGUMENT_PATTERN = re.compile(r"(?:^|\s)--agent-name[ =]([A-Za-z0-9_.-]{1,64})")
AGENT_COLOR_ARGUMENT_PATTERN = re.compile(r"(?:^|\s)--agent-color[ =]([a-z]{1,16})")
CLAUDE_EXECUTABLE_PATTERN = re.compile(r"^(?:\S*/)?claude(?:\s|$)|^\S*/claude/versions/\S+(?:\s|$)")
PANE_TITLE_STATUS_PREFIX_PATTERN = re.compile(r"^[^\w(¿¡\"']+")
GENERIC_PANE_TITLES = frozenset({"general-purpose", "claude", "claude code", "zsh", "bash", "-zsh", "nvim"})
TRANSCRIPT_TAIL_BYTES = 256 * 1024
TERMINAL_ANSWER_CHECK_INTERVAL_SECONDS = 1
MAXIMUM_LAST_MESSAGE_CHARACTERS = 6000
DENIED_FROM_DECK_MESSAGE = "Rechazado desde el Stream Deck"
SAFE_FILE_NAME_PATTERN = re.compile(r"[^A-Za-z0-9_.-]")
DIRECT_HTTP_OPENER = urllib.request.build_opener(urllib.request.ProxyHandler({}))


class StreamDeckUnavailable(Exception):
    pass


def load_configuration():
    try:
        configuration = json.loads(CONFIGURATION_PATH.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    if not isinstance(configuration, dict) or configuration.get("enabled") is False:
        return None
    machine = configuration.get("machine")
    server_url = configuration.get("server_url")
    if not isinstance(machine, str) or not isinstance(server_url, str):
        return None
    return {"machine": machine, "server_url": server_url.rstrip("/")}


def is_interactive_session():
    return os.environ.get("CLAUDE_CODE_ENTRYPOINT", INTERACTIVE_ENTRYPOINT) == INTERACTIVE_ENTRYPOINT


def deck_enabled_by_environment():
    return os.environ.get(DECK_ENABLED_ENVIRONMENT_VARIABLE, "").strip().lower() in DECK_ENABLING_VALUES


def send_json(server_url, method, path, body, timeout_seconds):
    request_data = None if body is None else json.dumps(body).encode("utf-8")
    http_request = urllib.request.Request(server_url + path, data=request_data, method=method)
    if request_data is not None:
        http_request.add_header("Content-Type", "application/json")
    try:
        with DIRECT_HTTP_OPENER.open(http_request, timeout=timeout_seconds) as http_response:
            return http_response.status, parse_json_object(http_response.read())
    except urllib.error.HTTPError as http_error:
        return http_error.code, parse_json_object(http_error.read())
    except (OSError, ValueError) as connection_error:
        raise StreamDeckUnavailable(str(connection_error)) from connection_error


def parse_json_object(response_bytes):
    try:
        parsed_body = json.loads(response_bytes.decode("utf-8") or "{}")
    except (UnicodeDecodeError, ValueError):
        return {}
    return parsed_body if isinstance(parsed_body, dict) else {}


def project_label(working_directory):
    if not isinstance(working_directory, str) or not working_directory:
        return "?"
    directory = Path(working_directory).expanduser()
    if directory == Path.home():
        return "~"
    return directory.name or str(directory)


def session_title_cache_path(session_id):
    return SESSION_TITLE_CACHE_DIRECTORY / SAFE_FILE_NAME_PATTERN.sub("_", session_id)


def remember_session_title(session_id, session_title):
    if not isinstance(session_id, str) or not session_id:
        return
    if not isinstance(session_title, str) or not session_title.strip():
        return
    try:
        SESSION_TITLE_CACHE_DIRECTORY.mkdir(parents=True, exist_ok=True)
        session_title_cache_path(session_id).write_text(session_title.strip(), encoding="utf-8")
    except OSError:
        return


def recall_session_title(session_id):
    if not session_id:
        return None
    try:
        return session_title_cache_path(session_id).read_text(encoding="utf-8").strip() or None
    except OSError:
        return None


def forget_session_title(session_id):
    if not isinstance(session_id, str) or not session_id:
        return
    try:
        session_title_cache_path(session_id).unlink()
    except OSError:
        return


def read_process_parent_and_command(process_id):
    try:
        process_output = subprocess.run(
            ["ps", "-o", "ppid=,command=", "-p", str(process_id)],
            capture_output=True,
            text=True,
            timeout=PROCESS_QUERY_TIMEOUT_SECONDS,
            check=True,
        ).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return None, ""
    parent_process_text, separator, command_line = process_output.partition(" ")
    if not separator or not parent_process_text.isdigit():
        return None, ""
    return int(parent_process_text), command_line.strip()


def find_teammate_identity():
    process_id = os.getppid()
    for unused_level in range(MAXIMUM_ANCESTOR_PROCESS_LEVELS):
        if process_id is None or process_id <= 1:
            return None, None
        parent_process_id, command_line = read_process_parent_and_command(process_id)
        if CLAUDE_EXECUTABLE_PATTERN.search(command_line):
            agent_name_match = AGENT_NAME_ARGUMENT_PATTERN.search(command_line)
            agent_color_match = AGENT_COLOR_ARGUMENT_PATTERN.search(command_line)
            return (
                agent_name_match.group(1) if agent_name_match else None,
                agent_color_match.group(1) if agent_color_match else None,
            )
        process_id = parent_process_id
    return None, None


def read_tmux_pane_details():
    tmux_pane = os.environ.get("TMUX_PANE")
    if not tmux_pane:
        return None
    try:
        tmux_output = subprocess.run(
            ["tmux", "display-message", "-p", "-t", tmux_pane, "#S\t#I\t#{pane_title}"],
            capture_output=True,
            text=True,
            timeout=TMUX_QUERY_TIMEOUT_SECONDS,
            check=True,
        ).stdout.rstrip("\n")
    except (OSError, subprocess.SubprocessError):
        return None
    pane_fields = tmux_output.split("\t", 2)
    if len(pane_fields) != 3 or not pane_fields[1]:
        return None
    return pane_fields


def meaningful_pane_title(raw_pane_title):
    pane_title = PANE_TITLE_STATUS_PREFIX_PATTERN.sub("", raw_pane_title or "").strip()
    if not pane_title or "/" in pane_title or pane_title.startswith("~"):
        return None
    if pane_title.lower() in GENERIC_PANE_TITLES or pane_title.lower().endswith(".local"):
        return None
    if pane_title.lower() == socket.gethostname().lower():
        return None
    return pane_title


def tmux_session_label(project):
    pane_details = read_tmux_pane_details()
    if pane_details is None:
        return None
    tmux_session_name, window_index, raw_pane_title = pane_details
    pane_title = meaningful_pane_title(raw_pane_title)
    if pane_title:
        return pane_title
    if tmux_session_name == project:
        return f"#{window_index}"
    return f"{tmux_session_name}#{window_index}"


def session_label(session_id, project, teammate_name):
    return (
        teammate_name
        or recall_session_title(session_id)
        or tmux_session_label(project)
        or session_id[:SHORT_SESSION_ID_LENGTH]
    )


def session_identity(hook_input, configuration):
    session_id = hook_input.get("session_id")
    if not isinstance(session_id, str) or not session_id:
        session_id = "unknown"
    project = project_label(hook_input.get("cwd"))
    teammate_name, teammate_color = find_teammate_identity()
    identity = {
        "machine": configuration["machine"],
        "session_id": session_id,
        "project": project,
        "session_label": session_label(session_id, project, teammate_name),
        "deck_enabled_by_environment": deck_enabled_by_environment(),
        "activity_event": hook_input.get("hook_event_name"),
        "session_start_source": hook_input.get("source"),
    }
    if teammate_color:
        identity["teammate_color"] = teammate_color
    agent_type = hook_input.get("agent_type")
    if isinstance(agent_type, str) and agent_type:
        identity["agent_label"] = agent_type
    return identity


class PendingDeckRequest:
    def __init__(self, server_url, request_id):
        self.server_url = server_url
        self.request_id = request_id
        self.finished = False

    def withdraw(self):
        if self.finished:
            return
        self.finished = True
        try:
            send_json(self.server_url, "DELETE", f"/api/requests/{self.request_id}", None, SHORT_REQUEST_TIMEOUT_SECONDS)
        except StreamDeckUnavailable:
            return

    def wait_for_answer(self):
        wait_path = f"/api/requests/{self.request_id}/wait?timeout={LONG_POLL_SECONDS}"
        deadline = time.monotonic() + OVERALL_WAIT_LIMIT_SECONDS
        consecutive_failures = 0
        while time.monotonic() < deadline:
            try:
                status_code, response_body = send_json(
                    self.server_url, "GET", wait_path, None, LONG_POLL_HTTP_TIMEOUT_SECONDS
                )
            except StreamDeckUnavailable:
                consecutive_failures += 1
                if consecutive_failures >= MAXIMUM_CONSECUTIVE_POLL_FAILURES:
                    self.withdraw()
                    return None
                time.sleep(POLL_FAILURE_PAUSE_SECONDS)
                continue
            consecutive_failures = 0
            if status_code != 200:
                self.withdraw()
                return None
            request_status = response_body.get("status")
            if request_status == "pending":
                continue
            self.finished = True
            return response_body.get("answer") if request_status == "answered" else None
        self.withdraw()
        return None


def withdraw_on_termination(pending_deck_request):
    def handle_termination_signal(unused_signal_number, unused_stack_frame):
        pending_deck_request.withdraw()
        sys.exit(0)

    for termination_signal in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(termination_signal, handle_termination_signal)


def transcript_entries_from_tail(transcript_path):
    try:
        with open(transcript_path, "rb") as transcript_file:
            transcript_file.seek(0, os.SEEK_END)
            transcript_file.seek(max(0, transcript_file.tell() - TRANSCRIPT_TAIL_BYTES))
            transcript_lines = transcript_file.read().decode("utf-8", errors="replace").splitlines()
    except OSError:
        return []
    transcript_entries = []
    for transcript_line in transcript_lines:
        try:
            transcript_entry = json.loads(transcript_line)
        except ValueError:
            continue
        if isinstance(transcript_entry, dict):
            transcript_entries.append(transcript_entry)
    return transcript_entries


def message_content_parts(transcript_entry):
    message = transcript_entry.get("message")
    if not isinstance(message, dict) or not isinstance(message.get("content"), list):
        return []
    return [content_part for content_part in message["content"] if isinstance(content_part, dict)]


def find_tool_use_id(hook_input):
    tool_use_id = hook_input.get("tool_use_id")
    if isinstance(tool_use_id, str) and tool_use_id:
        return tool_use_id
    transcript_path = hook_input.get("transcript_path")
    if not isinstance(transcript_path, str) or not transcript_path:
        return None
    transcript_content_parts = [
        content_part
        for transcript_entry in transcript_entries_from_tail(transcript_path)
        for content_part in message_content_parts(transcript_entry)
    ]
    resolved_tool_use_ids = {
        content_part.get("tool_use_id")
        for content_part in transcript_content_parts
        if content_part.get("type") == "tool_result"
    }
    unresolved_tool_uses_with_same_name = [
        content_part
        for content_part in transcript_content_parts
        if content_part.get("type") == "tool_use"
        and content_part.get("name") == hook_input.get("tool_name")
        and isinstance(content_part.get("id"), str)
        and content_part.get("id") not in resolved_tool_use_ids
    ]
    unresolved_tool_uses_with_same_input = [
        tool_use
        for tool_use in unresolved_tool_uses_with_same_name
        if tool_use.get("input") == hook_input.get("tool_input")
    ]
    best_matching_tool_uses = unresolved_tool_uses_with_same_input or unresolved_tool_uses_with_same_name
    return best_matching_tool_uses[0]["id"] if best_matching_tool_uses else None


class TerminalAnswerWatcher:
    def __init__(self, transcript_path, tool_use_id):
        self.transcript_path = transcript_path
        self.tool_use_id = tool_use_id
        self.tool_use_id_marker = tool_use_id.encode("utf-8")
        self.read_offset = self.current_transcript_size()
        self.unfinished_line_bytes = b""

    def current_transcript_size(self):
        try:
            return os.path.getsize(self.transcript_path)
        except OSError:
            return 0

    def read_new_transcript_lines(self):
        try:
            with open(self.transcript_path, "rb") as transcript_file:
                transcript_file.seek(self.read_offset)
                new_bytes = transcript_file.read()
        except OSError:
            return []
        self.read_offset += len(new_bytes)
        complete_bytes = self.unfinished_line_bytes + new_bytes
        complete_lines = complete_bytes.split(b"\n")
        self.unfinished_line_bytes = complete_lines.pop()
        return complete_lines

    def line_holds_tool_result(self, transcript_line):
        if self.tool_use_id_marker not in transcript_line:
            return False
        try:
            transcript_entry = json.loads(transcript_line.decode("utf-8", errors="replace"))
        except ValueError:
            return False
        return isinstance(transcript_entry, dict) and any(
            content_part.get("type") == "tool_result" and content_part.get("tool_use_id") == self.tool_use_id
            for content_part in message_content_parts(transcript_entry)
        )

    def terminal_already_answered(self):
        return any(self.line_holds_tool_result(transcript_line) for transcript_line in self.read_new_transcript_lines())

    def watch_until_answered(self, pending_deck_request):
        while not pending_deck_request.finished:
            if self.terminal_already_answered():
                pending_deck_request.withdraw()
                return
            time.sleep(TERMINAL_ANSWER_CHECK_INTERVAL_SECONDS)


def withdraw_when_answered_in_terminal(hook_input, pending_deck_request):
    transcript_path = hook_input.get("transcript_path")
    tool_use_id = find_tool_use_id(hook_input)
    if not isinstance(transcript_path, str) or not transcript_path or tool_use_id is None:
        return
    terminal_answer_watcher = TerminalAnswerWatcher(transcript_path, tool_use_id)
    threading.Thread(
        target=terminal_answer_watcher.watch_until_answered, args=(pending_deck_request,), daemon=True
    ).start()


def ask_stream_deck(configuration, hook_input, kind, payload):
    request_body = dict(session_identity(hook_input, configuration), kind=kind, payload=payload)
    try:
        status_code, response_body = send_json(
            configuration["server_url"], "POST", "/api/requests", request_body, SHORT_REQUEST_TIMEOUT_SECONDS
        )
    except StreamDeckUnavailable:
        return None
    request_id = response_body.get("request_id")
    if status_code != 200 or response_body.get("status") != "pending" or not isinstance(request_id, str):
        return None
    pending_deck_request = PendingDeckRequest(configuration["server_url"], request_id)
    withdraw_on_termination(pending_deck_request)
    withdraw_when_answered_in_terminal(hook_input, pending_deck_request)
    return pending_deck_request.wait_for_answer()


def handle_question(configuration, hook_input):
    tool_input = hook_input.get("tool_input")
    if not isinstance(tool_input, dict):
        return None
    questions = tool_input.get("questions")
    if not isinstance(questions, list) or not questions:
        return None
    answer = ask_stream_deck(configuration, hook_input, "question", {"questions": questions})
    if not isinstance(answer, dict) or answer.get("type") != "question_answers":
        return None
    answers = answer.get("answers")
    if not isinstance(answers, dict) or not answers:
        return None
    return {
        "hookSpecificOutput": {
            "hookEventName": "PermissionRequest",
            "decision": {"behavior": "allow", "updatedInput": dict(tool_input, answers=answers)},
        }
    }


def permission_decision_body(decision, permission_suggestions):
    if decision == "allow":
        return {"behavior": "allow"}
    if decision == "allow_always":
        return {"behavior": "allow", "updatedPermissions": permission_suggestions}
    if decision == "deny":
        return {"behavior": "deny", "message": DENIED_FROM_DECK_MESSAGE}
    return None


def handle_permission(configuration, hook_input):
    permission_suggestions = hook_input.get("permission_suggestions")
    if not isinstance(permission_suggestions, list):
        permission_suggestions = []
    tool_input = hook_input.get("tool_input")
    payload = {
        "tool_name": hook_input.get("tool_name"),
        "tool_input": tool_input if isinstance(tool_input, dict) else {},
        "permission_suggestions": permission_suggestions,
    }
    answer = ask_stream_deck(configuration, hook_input, "permission", payload)
    if not isinstance(answer, dict) or answer.get("type") != "permission":
        return None
    decision_body = permission_decision_body(answer.get("decision"), permission_suggestions)
    if decision_body is None:
        return None
    return {"hookSpecificOutput": {"hookEventName": "PermissionRequest", "decision": decision_body}}


def text_from_message_content(message_content):
    if isinstance(message_content, str):
        return message_content
    if not isinstance(message_content, list):
        return ""
    text_parts = [
        content_part.get("text", "")
        for content_part in message_content
        if isinstance(content_part, dict) and content_part.get("type") == "text"
    ]
    return "\n".join(text_part for text_part in text_parts if isinstance(text_part, str))


def read_last_assistant_text(transcript_path):
    if not isinstance(transcript_path, str) or not transcript_path:
        return ""
    try:
        with open(transcript_path, "rb") as transcript_file:
            transcript_file.seek(0, os.SEEK_END)
            transcript_size = transcript_file.tell()
            transcript_file.seek(max(0, transcript_size - TRANSCRIPT_TAIL_BYTES))
            transcript_lines = transcript_file.read().decode("utf-8", errors="replace").splitlines()
    except OSError:
        return ""
    for transcript_line in reversed(transcript_lines):
        try:
            transcript_entry = json.loads(transcript_line)
        except ValueError:
            continue
        if not isinstance(transcript_entry, dict) or transcript_entry.get("type") != "assistant":
            continue
        assistant_message = transcript_entry.get("message")
        if not isinstance(assistant_message, dict):
            continue
        assistant_text = text_from_message_content(assistant_message.get("content")).strip()
        if assistant_text:
            return assistant_text
    return ""


def notify_stream_deck(configuration, path, body):
    try:
        send_json(configuration["server_url"], "POST", path, body, SHORT_REQUEST_TIMEOUT_SECONDS)
    except StreamDeckUnavailable:
        return


def handle_stop(configuration, hook_input):
    last_message = hook_input.get("last_assistant_message")
    if not isinstance(last_message, str) or not last_message.strip():
        last_message = read_last_assistant_text(hook_input.get("transcript_path"))
    waiting_body = dict(
        session_identity(hook_input, configuration), last_message=last_message[:MAXIMUM_LAST_MESSAGE_CHARACTERS]
    )
    notify_stream_deck(configuration, "/api/sessions/waiting", waiting_body)


def handle_session_activity(configuration, hook_input):
    remember_session_title(hook_input.get("session_id"), hook_input.get("session_title"))
    notify_stream_deck(configuration, "/api/sessions/active", session_identity(hook_input, configuration))


def handle_session_end(configuration, hook_input):
    notify_stream_deck(configuration, "/api/sessions/ended", session_identity(hook_input, configuration))
    forget_session_title(hook_input.get("session_id"))


def run_hook(hook_input, configuration):
    hook_event_name = hook_input.get("hook_event_name")
    tool_name = hook_input.get("tool_name")
    if hook_event_name == "PermissionRequest" and tool_name == QUESTION_TOOL_NAME:
        return handle_question(configuration, hook_input)
    if hook_event_name == "PermissionRequest" and tool_name not in TERMINAL_ONLY_PERMISSION_TOOL_NAMES:
        return handle_permission(configuration, hook_input)
    if hook_event_name == "Stop":
        handle_stop(configuration, hook_input)
    elif hook_event_name in ("SessionStart", "UserPromptSubmit"):
        handle_session_activity(configuration, hook_input)
    elif hook_event_name == "SessionEnd":
        handle_session_end(configuration, hook_input)
    return None


def record_unexpected_error():
    try:
        CACHE_DIRECTORY.mkdir(parents=True, exist_ok=True)
        if ERROR_LOG_PATH.exists() and ERROR_LOG_PATH.stat().st_size > MAXIMUM_ERROR_LOG_BYTES:
            ERROR_LOG_PATH.unlink()
        with open(ERROR_LOG_PATH, "a", encoding="utf-8") as error_log:
            error_log.write(time.strftime("%Y-%m-%d %H:%M:%S ") + traceback.format_exc() + "\n")
    except OSError:
        return


def main():
    try:
        hook_input = json.loads(sys.stdin.read() or "{}")
    except ValueError:
        return
    if not isinstance(hook_input, dict) or not is_interactive_session():
        return
    configuration = load_configuration()
    if configuration is None:
        return
    try:
        hook_output = run_hook(hook_input, configuration)
    except Exception:
        record_unexpected_error()
        return
    if hook_output is not None:
        sys.stdout.write(json.dumps(hook_output, ensure_ascii=False))


if __name__ == "__main__":
    main()
