#!/usr/bin/env bash
# Claude Code ⇄ tmux glue.
#
#   claude-tmux new [-w name] [dir] [args]  Open Claude in a new window named after the project (-w: in a git worktree)
#   claude-tmux project [client]            Fuzzy-pick a project → session named after it, with claude + nvim windows
#   claude-tmux next                        Jump to the pane where Claude needs you (then finished ones)
#   claude-tmux dashboard [client]          Every Claude pane with state, age and last message; Enter jumps
#   claude-tmux send [pane]                 Paste the last lines of a pane into the nearest Claude prompt
#   claude-tmux scratch                     Persistent scratch Claude session (shown in a popup)
#   claude-tmux team [pane]                 Move the other panes of this window (agent teammates) to their own window
#   claude-tmux dnd                         Toggle desktop notifications (icons in tmux keep working)
#   claude-tmux resume                      Restart the Claude conversation this pane had (used by tmux-resurrect)
#   claude-tmux statusline                  Claude Code statusLine command (model · context · cost)
#   claude-tmux hook                        Claude Code hook: reads the event JSON on stdin
#
# Pane options written by the hook and read by tmux.conf:
#   @claude        working | waiting | done      @claude_since  epoch of the last state change
#   @claude_msg    what it's waiting for / its last message
#   @claude_tool   the tool call it's about to make    @claude_ctx   "43% · $1.20" from the status line
# Global option @claude_dnd = on mutes desktop notifications.

set -uo pipefail

TMUX_BIN="$(command -v tmux || echo tmux)"
SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/claude-tmux"
REMIND_AFTER="${CLAUDE_REMIND_AFTER:-300}"   # seconds before re-notifying about a pane that still waits
PROJECT_ROOTS="${CLAUDE_TMUX_PROJECT_ROOTS:-$HOME/code $HOME/projects $HOME/dotfiles}"

t() { "$TMUX_BIN" "$@"; }

# Jump the given client (or the current one) to a pane, across sessions
focus_pane() {
    local pane="$1" client="${2:-}"
    t select-window -t "$pane" \; select-pane -t "$pane"
    t switch-client ${client:+-c "$client"} -t "$pane" 2>/dev/null || true
}

session_name_for() { basename "$1" | tr '.: ' '___'; }

# ── notifications ────────────────────────────────────────────────────

# True when the pane is on screen in a terminal that has focus.
pane_visible() {
    local pane="$1" info session
    info="$(t display -p -t "$pane" '#{pane_active}#{window_active} #{session_name}' 2>/dev/null)" || return 1
    [[ "${info%% *}" == "11" ]] || return 1
    session="${info#* }"
    t list-clients -F '#{client_session} #{client_flags}' 2>/dev/null | grep -q "^$session .*focused"
}

dnd_on() { [[ "$(t show -gv @claude_dnd 2>/dev/null)" == on ]]; }

# macOS bundle id of the terminal tmux runs in, so clicking a notification brings it forward
terminal_app() {
    [[ -n "${CLAUDE_NOTIFY_APP:-}" ]] && { echo "$CLAUDE_NOTIFY_APP"; return; }
    case "$(t show-environment -g TERM_PROGRAM 2>/dev/null | cut -d= -f2)" in
        iTerm.app) echo com.googlecode.iterm2 ;;
        kitty)     echo net.kovidgoyal.kitty ;;
        ghostty)   echo com.mitchellh.ghostty ;;
        WezTerm)   echo com.github.wez.wezterm ;;
        *)         echo com.apple.Terminal ;;
    esac
}

notify() {
    local title="$1" subtitle="$2" body="$3" pane="$4"
    local focus_cmd="$TMUX_BIN select-window -t '$pane' \; select-pane -t '$pane' \; switch-client -t '$pane'"
    case "$(uname -s)" in
        Darwin)
            # terminal-notifier: clicking brings the terminal forward and jumps to the pane. It needs
            # notification permission (System Settings → Notifications); osascript is the fallback.
            { command -v terminal-notifier &>/dev/null \
                && terminal-notifier -title "$title" -subtitle "$subtitle" -message "$body" \
                       -group "claude-$pane" -activate "$(terminal_app)" -execute "$focus_cmd" -sound default \
                || osascript - "$title" "$subtitle" "$body" <<'OSA'
on run argv
    display notification (item 3 of argv) with title (item 1 of argv) subtitle (item 2 of argv) sound name "Glass"
end run
OSA
            } </dev/null &>/dev/null &
            ;;
        Linux)
            if command -v notify-send &>/dev/null; then
                # -A waits for a click; run detached so the hook returns immediately
                ( action="$(notify-send -a "Claude Code" -A focus=Focus "$title" "$subtitle"$'\n'"$body" 2>/dev/null)"
                  [[ "$action" == focus ]] && eval "$focus_cmd" ) </dev/null &>/dev/null &
            fi
            ;;
    esac
}

# ── hook ─────────────────────────────────────────────────────────────

# One line describing a tool call: "Run: git push", "Edit: install.sh", "WebFetch: https://…"
TOOL_SUMMARY='
    .tool_input as $i
    | ($i.command // $i.file_path // $i.notebook_path // $i.url // $i.pattern // $i.query // $i.description // "") as $arg
    | ({Bash: "Run", Edit: "Edit", MultiEdit: "Edit", Write: "Write", NotebookEdit: "Edit", Read: "Read"}[.tool_name] // .tool_name) as $verb
    | if ($arg | test("^/")) and .tool_name != "Bash" then "\($verb): \($arg | split("/") | last)"
      else "\($verb): \($arg)" end
    | gsub("\\s+"; " ")'

# Plain text, one paragraph, no markdown noise
clean() { sed -E 's/\*\*|__|`|^#+ //g' | tr -s '[:space:]' ' ' | cut -c1-"${1:-180}"; }

# Remember which conversation runs in this pane, keyed by its tmux position, so
# tmux-resurrect can bring the same conversation back after a reboot.
save_conversation() {
    local pane="$1" sid="$2" key
    [[ -n "$sid" ]] || return 0
    key="$(t display -p -t "$pane" '#S:#I.#P' 2>/dev/null | tr '/' '_')" || return 0
    mkdir -p "$STATE_DIR"
    printf '%s\n' "$sid" > "$STATE_DIR/$key"
}

cmd_hook() {
    command -v jq &>/dev/null || exit 0
    local input pane event ntype cwd sid project branch state="" title="" body="" where
    input="$(cat)"
    pane="${TMUX_PANE:-}"
    [[ -n "$pane" && -n "${TMUX:-}" ]] || exit 0   # not running inside tmux: nothing to do

    # \x1f separator: with tabs, `read` would merge empty fields and shift the rest
    IFS=$'\x1f' read -r event ntype cwd sid < <(jq -r '[.hook_event_name, .notification_type // "", .cwd // "", .session_id // ""] | join("\u001f")' <<<"$input")
    case "$event" in
        SessionStart)
            t set -p -t "$pane" @claude_sid "$sid" 2>/dev/null
            save_conversation "$pane" "$sid"
            exit 0
            ;;
        PreToolUse)
            deny_when_budget_blocked "$pane"
            # Remember what Claude is about to do, so a permission prompt can say what it's for
            t set -p -t "$pane" @claude_tool "$(jq -r "$TOOL_SUMMARY" <<<"$input" | cut -c1-200)" 2>/dev/null
            exit 0
            ;;
        UserPromptSubmit)
            deny_when_budget_blocked "$pane"
            state=working
            save_conversation "$pane" "$sid"
            ;;
        PostToolUse) state=working ;;
        Notification)
            state=waiting
            case "$ntype" in
                auth_success) exit 0 ;;
                permission_prompt)
                    title="🔐 %s needs permission"
                    body="$(t display -p -t "$pane" '#{@claude_tool}' 2>/dev/null)"
                    ;;
                elicitation_dialog) title="❓ %s has a question" ;;
                idle_prompt)        title="💬 %s is waiting for you" ;;
                *)                  title="🔔 %s needs you" ;;
            esac
            [[ -n "$body" ]] || body="$(jq -r '.message // ""' <<<"$input" | clean)"
            ;;
        Stop)
            state=done
            title="✅ %s is done"
            body="$(jq -r '.last_assistant_message // ""' <<<"$input" | clean)"
            [[ -n "$body" ]] || body="Ready for your next prompt"
            ;;
        SessionEnd)
            t set -p -t "$pane" -u @claude \; set -p -t "$pane" -u @claude_tool \; set -p -t "$pane" -u @claude_msg \
              \; set -p -t "$pane" -u @claude_since \; set -p -t "$pane" -u @claude_sid \; set -p -t "$pane" -u @claude_ctx 2>/dev/null
            exit 0
            ;;
        *) exit 0 ;;
    esac

    # PostToolUse fires a lot; skip the tmux calls when nothing changes
    [[ "$state" == working && "$(t display -p -t "$pane" '#{@claude}' 2>/dev/null)" == working ]] && exit 0
    local now
    now="$(date +%s)"
    t set -p -t "$pane" @claude "$state" \; set -p -t "$pane" @claude_since "$now" \
      \; set -p -t "$pane" @claude_msg "$body" \; set -p -t "$pane" @claude_sid "$sid" 2>/dev/null

    [[ -n "$title" ]] || exit 0

    # Project = repo root name (or folder), plus branch: "dotfiles", "main"
    project="$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null || echo "$cwd")"
    project="$(basename "$project")"
    branch="$(git -C "$cwd" branch --show-current 2>/dev/null)"
    # Where to find it: "window 2 (dotfiles)"; session shown only when it has a real name, not 0/1/2
    where="$(t display -p -t "$pane" '#{?#{m/r:^[0-9]+$,#S},,#S › }window #I (#W)' 2>/dev/null)"
    # shellcheck disable=SC2059
    title="$(printf "$title" "$project")"

    if ! dnd_on && ! pane_visible "$pane"; then
        notify "$title" "${branch:+$branch · }$where" "$body" "$pane"
    fi
    if [[ "$state" == waiting && "$REMIND_AFTER" -gt 0 ]]; then
        # Detached, so Claude doesn't wait for it
        nohup "$SELF" remind "$pane" "$now" "$project" "${branch:+$branch · }$where" "$body" </dev/null &>/dev/null &
    fi
    exit 0
}

# Re-notify if the pane is still waiting on the same request after REMIND_AFTER seconds
cmd_remind() {
    local pane="$1" since="$2" project="$3" subtitle="$4" body="$5"
    sleep "$REMIND_AFTER"
    [[ "$(t display -p -t "$pane" '#{@claude}|#{@claude_since}' 2>/dev/null)" == "waiting|$since" ]] || exit 0
    dnd_on && exit 0
    pane_visible "$pane" && exit 0
    notify "⏰ $project still needs you ($(human_age "$REMIND_AFTER"))" "$subtitle" "$body" "$pane"
    wait
}

# ── navigation ───────────────────────────────────────────────────────

cmd_next() {
    local target="" want
    for want in waiting done; do
        target="$(t list-panes -a -F "#{?#{==:#{@claude},$want},#{pane_id},}" | grep -m1 . || true)"
        [[ -n "$target" ]] && break
    done
    if [[ -z "$target" ]]; then
        t display-message "No Claude session needs you"
        return
    fi
    focus_pane "$target"
}

human_age() {
    local s="$1"
    if   (( s < 60 ));   then echo "${s}s"
    elif (( s < 3600 )); then echo "$((s / 60))m"
    else                      echo "$((s / 3600))h$(( (s % 3600) / 60 ))m"
    fi
}

# Every pane that has run Claude, most urgent first. Tab separated: pane_id, then display columns.
dashboard_rows() {
    local now id state since loc proj msg icon rank age
    now="$(date +%s)"
    t list-panes -a -F $'#{pane_id}\x1f#{@claude}\x1f#{@claude_since}\x1f#S:#I\x1f#{b:pane_current_path}\x1f#{@claude_msg}\x1f#{@claude_sid}' |
    while IFS=$'\x1f' read -r id state since loc proj msg sid; do
        [[ -n "$state$sid" ]] || continue
        case "$state" in
            waiting) icon="● waiting"; rank=1 ;;
            done)    icon="✓ done   "; rank=2 ;;
            working) icon="… working"; rank=3 ;;
            *)       icon="  idle   "; rank=4 ;;
        esac
        age=""; [[ -n "$since" ]] && age="$(human_age $((now - since)))"
        printf '%s\t%s\t%s\t%-6s\t%-10s\t%-18s\t%s\n' "$rank" "$id" "$icon" "$age" "$loc" "$proj" "$msg"
    done | sort -t$'\t' -k1,1n | cut -f2-
}

cmd_dashboard() {
    local client="${1:-}" rows pick
    rows="$(dashboard_rows)"
    if [[ -z "$rows" ]]; then
        echo "No Claude sessions running."; sleep 1; return
    fi
    pick="$(fzf --delimiter=$'\t' --with-nth=2.. --ansi --reverse --no-sort \
        --header='Enter: jump · Esc: close' --prompt='Claude › ' \
        --preview="$TMUX_BIN capture-pane -ep -t {1} | grep -v '^\s*\$' | tail -n \$FZF_PREVIEW_LINES" \
        --preview-window='down,60%,border-top' <<<"$rows")" || return 0
    focus_pane "${pick%%$'\t'*}" "$client"
}

# ── sessions & windows ───────────────────────────────────────────────

cmd_new() {
    local worktree=""
    if [[ "${1:-}" == -w ]]; then
        worktree="${2:?usage: claude-tmux new -w <name> [dir]}"
        shift 2
    fi
    # Optional directory first; anything else is passed through to claude
    local dir="$PWD"
    if [[ $# -gt 0 && -d "$1" ]]; then
        dir="$(cd "$1" && pwd)"
        shift
    fi
    local name launch
    name="$(session_name_for "$dir")${worktree:+-$worktree}"
    # Claude creates the worktree and its branch itself (claude --worktree)
    launch="claude${worktree:+ --worktree $(printf '%q' "$worktree")}${*:+ $(printf '%q ' "$@")}"
    if [[ -n "${TMUX:-}" ]]; then
        local pane
        pane="$(t new-window -P -F '#{pane_id}' -c "$dir" -n "$name")"
        t send-keys -t "$pane" "$launch" Enter
    elif t has-session -t "=$name" 2>/dev/null; then
        exec "$TMUX_BIN" attach -t "=$name"
    else
        t new-session -d -s "$name" -c "$dir"
        t send-keys -t "=$name:" "$launch" Enter
        exec "$TMUX_BIN" attach -t "=$name"
    fi
}

# Open (or switch to) a session for a project: window "claude" running Claude, window "nvim"
open_project() {
    local dir="$1" client="${2:-}" name
    name="$(session_name_for "$dir")"
    if ! t has-session -t "=$name" 2>/dev/null; then
        t new-session -d -s "$name" -c "$dir" -n claude
        t send-keys -t "=$name:claude" claude Enter
        t new-window -d -t "=$name:" -c "$dir" -n nvim
        t send-keys -t "=$name:nvim" nvim Enter
    fi
    if [[ -n "$client" || -n "${TMUX:-}" ]]; then
        t switch-client ${client:+-c "$client"} -t "=$name"
    else
        exec "$TMUX_BIN" attach -t "=$name"
    fi
}

project_candidates() {
    {
        # Open sessions first, then frecent dirs, then git repos under the project roots
        t list-sessions -F '#{session_path}' 2>/dev/null
        command -v zoxide &>/dev/null && zoxide query -l 2>/dev/null | head -200
        local root
        for root in $PROJECT_ROOTS; do
            [[ -d "$root" ]] || continue
            [[ -d "$root/.git" ]] && echo "$root"
            find "$root" -mindepth 2 -maxdepth 4 -name .git -prune 2>/dev/null | sed 's|/\.git$||'
        done
    } | awk '!seen[$0]++' | grep -v "^$HOME\$" | sed "s|^$HOME|~|"
}

cmd_project() {
    local client="${1:-}" pick
    pick="$(project_candidates | fzf --reverse --prompt='Project › ' \
        --header='Enter: open/switch session (claude + nvim)' \
        --preview='ls -A $(eval echo {}) | head -40')"
    # Judge by the selection, not the exit code: find may get SIGPIPE when fzf exits early
    [[ -n "$pick" ]] || return 0
    open_project "${pick/#\~/$HOME}" "$client"
}

# Persistent scratch Claude, attached inside a tmux popup (prefix ? toggles it)
cmd_scratch() {
    "$HOME/.local/bin/ensure-memory-mcp-running" || true
    if ! t has-session -t =scratch 2>/dev/null; then
        t new-session -d -s scratch -c "$PWD" claude
        t set -t =scratch status off
    fi
    TMUX='' exec "$TMUX_BIN" attach -t =scratch
}

# Agent teams split the lead's window; move every other pane into a "<window>-team" window
cmd_team() {
    local lead="${1:-${TMUX_PANE:-}}" win panes first p
    win="$(t display -p -t "$lead" '#W')"
    panes="$(t list-panes -t "$lead" -F '#{pane_id}' | grep -vx "$lead")"
    if [[ -z "$panes" ]]; then
        t display-message "No other panes in this window"
        return
    fi
    first="$(head -1 <<<"$panes")"
    t break-pane -d -s "$first" -n "$win-team"
    for p in $(tail -n +2 <<<"$panes"); do
        t join-pane -d -s "$p" -t "$first"
    done
    t select-layout -t "$first" tiled
    t display-message "Teammates moved to window '$win-team'"
}

cmd_dnd() {
    if dnd_on; then
        t set -gu @claude_dnd
        t display-message "Claude notifications: ON"
    else
        t set -g @claude_dnd on
        t display-message "Claude notifications: OFF (icons in tmux still update)"
    fi
}

# ── context ──────────────────────────────────────────────────────────

# Paste the last lines of a pane (default: the current one) into the nearest Claude prompt
cmd_send() {
    local src="${1:-$(t display -p '#{pane_id}')}" lines="${CLAUDE_SEND_LINES:-60}"
    local target="" text cmd
    if [[ -n "$(t display -p -t "$src" '#{@claude}#{@claude_sid}')" ]]; then
        t display-message "This is a Claude pane; press it from the pane with the output"
        return
    fi
    # Nearest Claude pane: same window, then same session, then anywhere
    local scope
    for scope in "-t $src" "-s -t $src" "-a"; do
        # shellcheck disable=SC2086
        target="$(t list-panes $scope -F '#{?#{||:#{@claude},#{@claude_sid}},#{pane_id},}' | grep -m1 . || true)"
        [[ -n "$target" ]] && break
    done
    if [[ -z "$target" ]]; then
        t display-message "No Claude pane found (start one with prefix C)"
        return
    fi
    cmd="$(t display -p -t "$src" '#{pane_current_command} in #{pane_current_path}')"
    # Trim trailing blank lines so the paste ends at the last real output
    text="$(t capture-pane -p -J -S "-$lines" -t "$src" | sed -e :a -e '/^[[:space:]]*$/{$d;N;ba' -e '}')"
    printf 'Output from %s:\n```\n%s\n```\n' "$cmd" "$text" | t load-buffer -b claude-send -
    t paste-buffer -p -d -b claude-send -t "$target"
    focus_pane "$target"
}

# Claude Code statusLine: prints "Opus 5.5 · 43% ctx · $1.20" and mirrors context/cost to the tmux pane border
cmd_statusline() {
    local input line
    input="$(cat)"
    line="$(jq -r '
        [ (.model.display_name // empty),
          (.context_window.used_percentage // empty | "\(floor)% ctx"),
          (.cost.total_cost_usd // empty | "$\(. * 100 | round / 100)")
        ] | join(" · ")' <<<"$input" 2>/dev/null)"
    if [[ -n "${TMUX_PANE:-}" && -n "${TMUX:-}" ]]; then
        local total_cost_usd budget_usd budget_state budget_suffix=""
        total_cost_usd="$(jq -r '.cost.total_cost_usd // empty | . * 100 | round / 100' <<<"$input" 2>/dev/null)"
        [[ -n "$total_cost_usd" ]] && evaluate_pane_budget "$TMUX_PANE" "$total_cost_usd"
        IFS='|' read -r budget_usd budget_state < <(run_tmux display -p -t "$TMUX_PANE" '#{@claude_budget_usd}|#{@claude_budget_state}' 2>/dev/null)
        [[ -n "$budget_usd" ]] && budget_suffix="/\$$budget_usd"
        [[ "$budget_state" == blocked ]] && budget_suffix+=" ⛔"
        t set -p -t "$TMUX_PANE" @claude_ctx "$(jq -r --arg budget_suffix "$budget_suffix" '
            [ (.context_window.used_percentage // empty | "\(floor)%"),
              (.cost.total_cost_usd // empty | "$\(. * 100 | round / 100)" + $budget_suffix) ] | join(" · ")' <<<"$input" 2>/dev/null)" 2>/dev/null
    fi
    echo "$line"
}

# tmux-resurrect restore: reopen this pane's conversation (or the latest in this directory)
cmd_resume() {
    local key sid=""
    "$HOME/.local/bin/ensure-memory-mcp-running" || true
    if [[ -n "${TMUX_PANE:-}" ]]; then
        key="$(t display -p -t "$TMUX_PANE" '#S:#I.#P' | tr '/' '_')"
        [[ -f "$STATE_DIR/$key" ]] && sid="$(cat "$STATE_DIR/$key")"
    fi
    if [[ -n "$sid" ]]; then
        exec claude --resume "$sid"
    else
        exec claude --continue
    fi
}

BUDGET_WARNING_PERCENT="${CLAUDE_TMUX_BUDGET_WARNING_PERCENT:-80}"
BUDGET_RAISE_STEP_USD="${CLAUDE_TMUX_BUDGET_RAISE_STEP_USD:-5}"
PROJECT_TEAM_CONFIGURATION_PATH=".claude-tmux/team.json"
USER_TEAM_CONFIGURATION_PATH="${XDG_CONFIG_HOME:-$HOME/.config}/claude-tmux/team.json"

read -r -d '' DEFAULT_TEAM_CONFIGURATION <<'JSON'
{
  "budgetUsd": 5,
  "sharedPrompt": "You work in a small software team inside tmux. Before starting, call memory_search on the memory MCP with the project name and the topic. After finishing, store durable findings with memory_store, tagged project:<project> and role:<role>. Hand work over as short written artifacts: a ticket, a decision, a test report. Never paste long chat history.",
  "roles": [
    {
      "name": "tl",
      "model": "opus",
      "worktree": false,
      "prompt": "You are the tech lead. Split the request into small independent tickets, assign each one to a developer, review their branches, then rebase and merge. You own architecture decisions; developers do not."
    },
    {
      "name": "dev",
      "model": "sonnet",
      "worktree": true,
      "count": 1,
      "prompt": "You are a developer. Work only on the ticket you were given, inside your own worktree. Make small commits and report what changed and how to verify it."
    },
    {
      "name": "qa",
      "model": "sonnet",
      "worktree": false,
      "prompt": "You are QA with a clean context. Review the developer branch against the ticket acceptance criteria, write and run tests, and report defects. Never edit production code."
    }
  ]
}
JSON

run_tmux() { "$TMUX_BIN" "$@"; }

resolve_team_configuration() {
    local project_directory="$1" configuration_path
    for configuration_path in "$project_directory/$PROJECT_TEAM_CONFIGURATION_PATH" "$USER_TEAM_CONFIGURATION_PATH"; do
        if [[ -f "$configuration_path" ]]; then
            cat "$configuration_path"
            return
        fi
    done
    printf '%s' "$DEFAULT_TEAM_CONFIGURATION"
}

ensure_project_team_configuration() {
    local project_directory="$1"
    local project_configuration_path="$project_directory/$PROJECT_TEAM_CONFIGURATION_PATH"
    [[ -f "$project_configuration_path" ]] && return 0
    local inherited_team_configuration
    inherited_team_configuration="$(resolve_team_configuration "$project_directory")"
    mkdir -p "$(dirname "$project_configuration_path")"
    printf '%s\n' "$inherited_team_configuration" > "$project_configuration_path"
    run_tmux display-message "Created $PROJECT_TEAM_CONFIGURATION_PATH with the default team" 2>/dev/null
}

build_role_launch_command() {
    local model="$1" window_name="$2" full_prompt="$3" uses_worktree="$4"
    local launch_command="claude --model $(printf '%q' "$model") --name $(printf '%q' "$window_name")"
    launch_command+=" --append-system-prompt $(printf '%q' "$full_prompt")"
    [[ "$uses_worktree" == true ]] && launch_command+=" --worktree $(printf '%q' "$window_name")"
    printf '%s' "$launch_command"
}

open_role_window() {
    local session_name="$1" project_directory="$2" window_name="$3" role_name="$4" budget_usd="$5" launch_command="$6"
    local pane_identifier
    if run_tmux has-session -t "=$session_name" 2>/dev/null; then
        pane_identifier="$(run_tmux new-window -d -P -F '#{pane_id}' -t "=$session_name:" -c "$project_directory" -n "$window_name")"
    else
        pane_identifier="$(run_tmux new-session -d -P -F '#{pane_id}' -s "$session_name" -c "$project_directory" -n "$window_name")"
    fi
    run_tmux set -p -t "$pane_identifier" @claude_role "$role_name" \; \
        set -p -t "$pane_identifier" @claude_budget_usd "$budget_usd" \; \
        set -p -t "$pane_identifier" @claude_budget_state ok
    run_tmux send-keys -t "$pane_identifier" "$launch_command" Enter
}

cmd_team_up() {
    local project_directory="${1:-$PWD}"
    project_directory="$(cd "$project_directory" && pwd)" || return 1
    local project_name session_name team_configuration shared_prompt default_budget_usd role_definition
    project_name="$(session_name_for "$project_directory")"
    session_name="$project_name-team"
    ensure_project_team_configuration "$project_directory"
    team_configuration="$(resolve_team_configuration "$project_directory")"
    jq -e '.roles | length > 0' <<<"$team_configuration" >/dev/null 2>&1 || {
        run_tmux display-message "Invalid team configuration: no roles defined"
        return 1
    }
    shared_prompt="$(jq -r '.sharedPrompt // ""' <<<"$team_configuration")"
    default_budget_usd="$(jq -r '.budgetUsd // 5' <<<"$team_configuration")"

    if ! run_tmux has-session -t "=$session_name" 2>/dev/null; then
        while IFS= read -r role_definition; do
            local role_name role_model role_budget_usd uses_worktree role_count role_prompt role_index window_name full_prompt
            role_name="$(jq -r '.name' <<<"$role_definition")"
            role_model="$(jq -r '.model // "sonnet"' <<<"$role_definition")"
            role_budget_usd="$(jq -r --arg fallback "$default_budget_usd" '.budgetUsd // $fallback' <<<"$role_definition")"
            uses_worktree="$(jq -r '.worktree // false' <<<"$role_definition")"
            role_count="$(jq -r '.count // 1' <<<"$role_definition")"
            role_prompt="$(jq -r '.prompt // ""' <<<"$role_definition")"
            for (( role_index = 1; role_index <= role_count; role_index++ )); do
                window_name="$project_name-$role_name"
                (( role_count > 1 )) && window_name+="-$role_index"
                full_prompt="Project: $project_name. Role: $role_name. $role_prompt $shared_prompt"
                open_role_window "$session_name" "$project_directory" "$window_name" "$role_name" "$role_budget_usd" \
                    "$(build_role_launch_command "$role_model" "$window_name" "$full_prompt" "$uses_worktree")"
            done
        done < <(jq -c '.roles[]' <<<"$team_configuration")
    fi

    if [[ -n "${TMUX:-}" ]]; then
        run_tmux switch-client -t "=$session_name"
    else
        exec "$TMUX_BIN" attach -t "=$session_name"
    fi
}

describe_budget_usage_percent() {
    local total_cost_usd="$1" budget_usd="$2"
    awk -v cost="$total_cost_usd" -v budget="$budget_usd" 'BEGIN { if (budget > 0) printf "%d", cost / budget * 100; else print 0 }'
}

record_budget_state() {
    local pane_identifier="$1" new_budget_state="$2"
    run_tmux set -p -t "$pane_identifier" @claude_budget_state "$new_budget_state" 2>/dev/null
}

notify_budget_event() {
    local pane_identifier="$1" headline="$2" total_cost_usd="$3" budget_usd="$4"
    local role_name
    role_name="$(run_tmux display -p -t "$pane_identifier" '#{@claude_role}' 2>/dev/null)"
    dnd_on && return 0
    notify "$headline" "${role_name:-agent} · \$$total_cost_usd of \$$budget_usd" "Press prefix + B to approve more budget" "$pane_identifier"
}

evaluate_pane_budget() {
    local pane_identifier="$1" total_cost_usd="$2"
    local budget_usd budget_state usage_percent
    IFS='|' read -r budget_usd budget_state < <(run_tmux display -p -t "$pane_identifier" '#{@claude_budget_usd}|#{@claude_budget_state}' 2>/dev/null)
    [[ -n "$budget_usd" ]] || return 0
    usage_percent="$(describe_budget_usage_percent "$total_cost_usd" "$budget_usd")"
    if (( usage_percent >= 100 )) && [[ "$budget_state" != blocked ]]; then
        record_budget_state "$pane_identifier" blocked
        notify_budget_event "$pane_identifier" "⛔ Budget exhausted" "$total_cost_usd" "$budget_usd"
    elif (( usage_percent >= BUDGET_WARNING_PERCENT && usage_percent < 100 )) && [[ "$budget_state" != warned && "$budget_state" != blocked ]]; then
        record_budget_state "$pane_identifier" warned
        notify_budget_event "$pane_identifier" "⚠️ Budget at ${usage_percent}%" "$total_cost_usd" "$budget_usd"
    fi
}

deny_when_budget_blocked() {
    local pane_identifier="$1"
    local budget_state
    budget_state="$(run_tmux display -p -t "$pane_identifier" '#{@claude_budget_state}' 2>/dev/null)"
    [[ "$budget_state" == blocked ]] || return 0
    echo "Budget exhausted for this role. Stop working and tell the user to press prefix + B in tmux to approve more budget." >&2
    exit 2
}

cmd_budget_raise() {
    local pane_identifier="${1:-$(run_tmux display -p '#{pane_id}')}"
    local current_budget_usd raised_budget_usd
    current_budget_usd="$(run_tmux display -p -t "$pane_identifier" '#{@claude_budget_usd}')"
    if [[ -z "$current_budget_usd" ]]; then
        run_tmux display-message "This pane has no budget"
        return 0
    fi
    raised_budget_usd="$(awk -v current="$current_budget_usd" -v step="$BUDGET_RAISE_STEP_USD" 'BEGIN { print current + step }')"
    run_tmux set -p -t "$pane_identifier" @claude_budget_usd "$raised_budget_usd"
    record_budget_state "$pane_identifier" ok
    run_tmux display-message "Budget raised to \$$raised_budget_usd"
}

case "${1:-}" in
    team-up)    shift; cmd_team_up "$@" ;;
    budget-raise) shift; cmd_budget_raise "$@" ;;
    hook)       cmd_hook ;;
    remind)     shift; cmd_remind "$@" ;;
    next)       cmd_next ;;
    new)        shift; cmd_new "$@" ;;
    project)    shift; cmd_project "$@" ;;
    dashboard)  shift; cmd_dashboard "$@" ;;
    send)       shift; cmd_send "$@" ;;
    scratch)    cmd_scratch ;;
    team)       shift; cmd_team "$@" ;;
    dnd)        cmd_dnd ;;
    resume)     cmd_resume ;;
    statusline) cmd_statusline ;;
    *)          sed -n '2,15s/^# \{0,1\}//p' "$0"
                echo "  claude-tmux team-up [dir]               Open a team session (roles from .claude-tmux/team.json, ~/.config/claude-tmux/team.json or the default tl+dev+qa)"
                echo "  claude-tmux budget-raise [pane]         Approve more budget for a blocked pane"
                exit 1 ;;
esac
